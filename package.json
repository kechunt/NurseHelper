{
  "name": "nurse-helper",
  "version": "1.0.0",
  "description": "Sistema de gestión de enfermería - Frontend y Backend",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "tunnel": "node scripts/tunnel.js",
    "tunnel:stop": "node scripts/tunnel-stop.js",
    "tunnel:win": "node scripts/tunnel.js",
    "dev:tunnel": "npm run tunnel",
    "dev:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:simple": "concurrently -n \"🔷 BACKEND,🟡 FRONTEND\" -c \"cyan,yellow\" --kill-others-on-fail --restart-tries 3 --restart-after 2000 \"npm run start:backend\" \"npm run start:frontend\"",
    "start": "npm run dev",
    "start:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npm start",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "test:frontend": "cd frontend && npm test",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm run test:unit",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:root": "eslint scripts --max-warnings 9999",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "migration:run": "cd backend && npm run migration:run",
    "migration:run:prod": "cd backend && npm run migration:run:prod",
    "migration:generate": "cd backend && npm run migration:generate"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
